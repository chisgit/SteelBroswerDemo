# Copy to .env for local `netlify dev`, or set in Netlify UI (Site settings -> Environment).
# NEVER commit real values. These are read server-side in netlify/functions only (R10).

# Steel hosted cloud API key — https://app.steel.dev (free tier: 100 browser hours).
STEEL_API_KEY=

# Google Gemini API key (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the public base URL the agent navigates to (defaults to the deploy URL).
# Useful for local dev so the cloud browser can reach a tunneled/static target.
GAUNTLET_BASE_URL=
